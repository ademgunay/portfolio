---
import WritingPage from '../../components/pages/WritingPage.astro';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.length > 0 ? [{ params: { index: undefined }, props: { posts } }] : [];
}
const { posts } = Astro.props;
---
<WritingPage lang="en" posts={posts} />
