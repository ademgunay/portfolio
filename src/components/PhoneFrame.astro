---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { images: ImageMetadata[]; alt: string; tilt?: boolean; class?: string; eager?: boolean }
const { images, alt, tilt = false, class: cls = '', eager = false } = Astro.props;
---
<div
  class:list={['phone relative mx-auto aspect-[9/19.5] w-full max-w-[280px] overflow-hidden rounded-[2.5rem] border-[6px] border-border bg-surface shadow-2xl shadow-black/60', tilt && 'rotate-[6deg]', cls]}
  data-phone
>
  {images.map((img, i) => (
    <Image
      src={img}
      alt={i === 0 ? alt : ''}
      widths={[280, 560]}
      sizes="280px"
      loading={eager && i === 0 ? 'eager' : 'lazy'}
      class="absolute inset-0 h-full w-full object-cover transition-opacity duration-500"
      data-hidden={i > 0 ? '' : undefined}
      style={i > 0 ? 'opacity:0' : undefined}
    />
  ))}
  <span aria-hidden="true" class="absolute left-1/2 top-2 h-5 w-20 -translate-x-1/2 rounded-full bg-black/80"></span>
</div>
