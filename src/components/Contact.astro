---
import { profile } from '../content/profile';
import { cvHref } from '../lib/cv';
import { t, type Lang } from '../i18n/ui';
import SectionHeading from './SectionHeading.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const cv = cvHref(lang);
const links = [
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'GitHub', href: profile.links.github },
  { label: 'Medium', href: profile.links.medium },
];
---
<section aria-labelledby="contact" class="mx-auto max-w-4xl px-4 py-32 text-center md:px-8">
  <SectionHeading index="06" title={t(lang, 'contact.title')} id="contact" />
  <p class="mx-auto max-w-xl text-lg text-muted" data-reveal>{t(lang, 'contact.lead')}</p>
  <div class="mt-10 flex flex-col items-center gap-6" data-reveal>
    <a href={`mailto:${profile.email}`} data-copy-email data-email={profile.email} data-copied-text={t(lang, 'contact.copied')} title={t(lang, 'contact.copyTitle')} aria-describedby="copy-email-hint"
      class="rounded-xl border border-border bg-surface px-6 py-4 font-mono text-lg transition hover:border-blue md:text-2xl">
      {profile.email} <span class="text-muted text-sm" aria-hidden="true">⧉</span>
    </a>
    <span id="copy-email-hint" class="sr-only">{t(lang, 'contact.copyHint')}</span>
    <p role="status" aria-live="polite" class="h-5 font-mono text-sm text-green" data-copy-toast></p>
    <ul class="flex flex-wrap justify-center gap-4 font-mono text-sm">
      <li><a href={`mailto:${profile.email}`} class="text-muted hover:text-text">{t(lang, 'contact.email')}</a></li>
      {links.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-text">{l.label} ↗</a></li>)}
      <li><a href={cv} download class="text-muted hover:text-text">{t(lang, 'contact.cv')}</a></li>
    </ul>
  </div>
</section>
<script>
  const btn = document.querySelector<HTMLAnchorElement>('[data-copy-email]');
  const toast = document.querySelector<HTMLElement>('[data-copy-toast]');
  let timer: ReturnType<typeof setTimeout> | undefined;
  btn?.addEventListener('click', async (e) => {
    if (!navigator.clipboard) return; // fall back to mailto
    e.preventDefault();
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? '');
      if (toast) {
        toast.textContent = btn.dataset.copiedText ?? '';
        clearTimeout(timer);
        timer = setTimeout(() => (toast.textContent = ''), 2500);
      }
    } catch {
      location.href = btn.href;
    }
  });
</script>
