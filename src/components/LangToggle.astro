---
import { LANGS, t, type Lang } from '../i18n/ui';
import { switchLocalePath } from '../i18n/paths';

interface Props { lang: Lang; class?: string }
const { lang, class: cls = '' } = Astro.props;
const here = Astro.url.pathname;
---
<div role="group" aria-label={t(lang, 'lang.toggleAria')} class:list={['flex items-center rounded-md border border-border font-mono text-xs', cls]} data-lang-toggle>
  {LANGS.map((l) =>
    l === lang ? (
      <span aria-current="true" class="px-2 py-1 text-text">{t(l, 'lang.short')}</span>
    ) : (
      <a href={switchLocalePath(here, l)} hreflang={l} lang={l} aria-label={t(l, 'lang.switchLabel')}
        class="px-2 py-1 text-muted transition-colors hover:text-text">{t(l, 'lang.short').toLowerCase()}</a>
    ),
  )}
</div>
<script>
  // Keep the current section when switching language (no JS → lands at the top of the other page).
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-toggle] a').forEach((a) =>
    a.addEventListener('click', () => {
      if (location.hash && !a.href.includes('#')) a.href += location.hash;
    }),
  );
</script>
