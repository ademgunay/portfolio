---
import { profile } from '../content/profile';
import { getPublishedPosts } from '../lib/posts';
import { withBase } from '../lib/url';

const hasWriting = (await getPublishedPosts()).length > 0;
const links = [
  { label: 'Apps', href: withBase('/#apps') },
  { label: 'Experience', href: withBase('/#experience') },
  { label: 'Skills', href: withBase('/#skills') },
  { label: 'About', href: withBase('/#about') },
  ...(hasWriting ? [{ label: 'Writing', href: withBase('/blog/') }] : []),
];
const cv = withBase(profile.cvPath);
---
<header class="fixed inset-x-0 top-0 z-50 transition-colors duration-300" data-nav>
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:px-8">
    <a href={withBase('/')} class="font-mono text-lg font-semibold text-text" aria-label="Adem Gunay, home">AG<span class="text-green">_</span></a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {links.map((l) => <li><a class="transition-colors hover:text-text" href={l.href}>{l.label}</a></li>)}
      <li><a href={cv} class="rounded-md border border-border px-3 py-1.5 font-mono text-text hover:border-blue" download>CV</a></li>
    </ul>
    <details class="md:hidden" data-mobile-menu>
      <summary class="list-none cursor-pointer rounded-md border border-border px-3 py-1.5 font-mono text-sm" aria-label="Menu">menu</summary>
      <ul class="fixed inset-0 top-16 flex flex-col gap-6 bg-bg/95 p-8 text-2xl backdrop-blur">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        <li><a href={cv} download>Download CV</a></li>
      </ul>
    </details>
  </nav>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const onScroll = () => nav?.classList.toggle('nav-scrolled', window.scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
</script>
<style is:global>
  .nav-scrolled { background: color-mix(in srgb, var(--color-bg) 80%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-border); }
</style>
