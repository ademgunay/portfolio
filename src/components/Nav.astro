---
import { profile } from '../content/profile';
import { getPublishedPosts } from '../lib/posts';
import { cvHref } from '../lib/cv';
import { localePath } from '../i18n/paths';
import { t, type Lang } from '../i18n/ui';
import LangToggle from './LangToggle.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;

const hasWriting = (await getPublishedPosts()).length > 0;
const links = [
  { label: t(lang, 'nav.apps'), href: localePath(lang, '/#apps') },
  { label: t(lang, 'nav.experience'), href: localePath(lang, '/#experience') },
  { label: t(lang, 'nav.skills'), href: localePath(lang, '/#skills') },
  { label: t(lang, 'nav.about'), href: localePath(lang, '/#about') },
  ...(hasWriting ? [{ label: t(lang, 'nav.writing'), href: localePath(lang, '/blog/') }] : []),
];
const cv = cvHref(lang);
---
<header class="fixed inset-x-0 top-0 z-50 transition-colors duration-300" data-nav>
  <nav aria-label={t(lang, 'nav.primary')} class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 md:px-8">
    <a href={localePath(lang, '/')} class="font-mono text-lg font-semibold text-text" aria-label={t(lang, 'nav.home', { name: profile.name })}>AG<span class="text-green">_</span></a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {links.map((l) => <li><a class="transition-colors hover:text-text" href={l.href}>{l.label}</a></li>)}
      <li><LangToggle lang={lang} /></li>
      <li><a href={cv} class="rounded-md border border-border px-3 py-1.5 font-mono text-text hover:border-blue" download>{t(lang, 'nav.cv')}</a></li>
    </ul>
    <div class="flex items-center gap-3 md:hidden">
      <LangToggle lang={lang} />
      <details data-mobile-menu>
        <summary class="list-none cursor-pointer rounded-md border border-border px-3 py-1.5 font-mono text-sm" aria-label={t(lang, 'nav.menuAria')}>{t(lang, 'nav.menu')}</summary>
        <ul class="fixed inset-0 top-16 flex flex-col gap-6 bg-bg/95 p-8 text-2xl backdrop-blur">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          <li><a href={cv} download>{t(lang, 'cta.downloadCv')}</a></li>
        </ul>
      </details>
    </div>
  </nav>
</header>
<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  const onScroll = () => nav?.classList.toggle('nav-scrolled', window.scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !menu?.open) return;
    menu.removeAttribute('open');
    menu.querySelector('summary')?.focus();
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')));
</script>
<style is:global>
  [data-nav]::before { content: ''; position: absolute; inset: 0; z-index: -1; opacity: 0; pointer-events: none; transition: opacity 300ms; background: color-mix(in srgb, var(--color-bg) 80%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-border); }
  [data-mobile-menu] summary::-webkit-details-marker { display: none; }
  .nav-scrolled::before { opacity: 1; }
</style>
