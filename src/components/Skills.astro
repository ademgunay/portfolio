---
import { skills } from '../content/skills';
import SectionHeading from './SectionHeading.astro';
import { pick, t, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section aria-labelledby="skills" class="mx-auto max-w-4xl px-4 py-24 md:px-8">
  <SectionHeading index="03" title={t(lang, 'skills.title')} id="skills" />
  <pre class="overflow-x-auto rounded-xl border border-border bg-surface p-6 font-mono text-sm leading-7" data-reveal><code><span class="text-purple">object</span> <span class="text-blue">Skills</span> {"{"}
{skills.map((g) => { const items = pick(g.items, lang); return (
<span>    <span class="text-purple">val</span> {g.key} = <span class="text-blue">listOf</span>({items.map((s, i) => <><span class="md:hidden">{"\n        "}</span><span class="text-green">"{s}"</span>{i < items.length - 1 ? <>,<span class="max-md:hidden"> </span></> : ''}</>)}<span class="md:hidden">{"\n    "}</span>)
</span>); })}{"}"}</code></pre>
</section>
